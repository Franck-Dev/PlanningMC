{{ form_start(form) }}
    <div class="form-row align-items-center">
        <div class="form-group col-md-4">
            {{form_row(form.artGamm, {'attr' : {'placeholder' : "Proposer une date" }}) }}
        </div>
        <div class="form-group col-md-8">
            {{form_row(form.DescriptifPhase, {'attr' : {'placeholder' : "Décrire le détail de cette phase" }}) }}
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-3">
            {{form_row(form.eqOut) }}
        </div>
        <div class="form-group col-md-3">
            {{form_row(form.progLaser) }}
        </div>
        <div class="form-group col-md-3">
            {{form_row(form.progPolym) }}
        </div>
        <div class="form-group col-md-3">
            {{form_row(form.programme) }}
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-2">
            {{form_row(form.cycleMoulage) }}
        </div>
        <div class="form-group col-md-2">
            {{form_row(form.active) }}
        </div>
        <div class="form-group col-md-4">
            {{form_row(form.zoneTrav) }}
        </div>
        <div class="form-group col-md-4">
            {{form_row(form.debVal) }}
        </div>
    </div>
    <button class="btn btn-success"><i class="fa fa-check m-1"></i>{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
